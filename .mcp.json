{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}/projects",
        "/tmp"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2.0.0",
        "mcp-fetch"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2.0.0",
        "mcp-server-git",
        "--repository",
        "${HOME}/projects/portal-5"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project",
        "${HOME}/projects/portal-5"
      ]
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-docker-server"
      ]
    },
    "portal-music-minimax": {
      "type": "http",
      "url": "http://localhost:8912/mcp"
    },
    "portal-documents": {
      "type": "http",
      "url": "http://localhost:8913/mcp"
    },
