<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.portal5.update-check</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd __PORTAL_ROOT__ &amp;&amp; . scripts/lib/host_dotenv.sh &amp;&amp; portal_export_dotenv_keys .env GITHUB_TOKEN OMLX_VENV_PATH OLLAMA_HOST PORTAL5_STORAGE_FLOOR_GIB PORTAL5_STORAGE_FLOOR_PERCENT PORTAL5_STORAGE_ROOT PUSHOVER_API_TOKEN PUSHOVER_USER_KEY &amp;&amp; exec .venv/bin/python scripts/check_updates.py</string>
    </array>
    <!-- Keys read by check_updates.py. Empty ones stay unset so the defaults apply. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- Weekly: Monday 13:07 local. Reports upstream drift + GitHub security
         advisories for the Obscura pin, Ollama, and oMLX; Pushover push only when
         a component is behind (high-priority if the gap is security-flagged). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>13</integer>
        <key>Minute</key>
        <integer>7</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/update-check.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/update-check.launchd.log</string>
</dict>
</plist>
