<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.portal5.security-sweep</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd __PORTAL_ROOT__ &amp;&amp; for k in TELEGRAM_ALERT_BOT_TOKEN TELEGRAM_BOT_TOKEN TELEGRAM_ALERT_CHANNEL_ID TELEGRAM_USER_IDS PUSHOVER_API_TOKEN PUSHOVER_USER_KEY; do export "$k=$(grep -E "^$k=" .env 2&gt;/dev/null | tail -1 | cut -d= -f2- | tr -d "\"'")"; done; exec .venv/bin/python scripts/security_sweep.py --output-dir __HOME__/.portal5/security</string>
    </array>
    <!-- Only the alert keys are taken from .env (arm-queue pattern): sourcing the whole
         file imports container hostnames/paths and every secret into the job. Keys read
         by _telegram_alert (security_sweep.py) and _pushover (check_updates.py). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- Weekly, Sunday 03:27 local, after security dependency upgrades at 03:17. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>27</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/security-sweep.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/security-sweep.launchd.log</string>
</dict>
</plist>
