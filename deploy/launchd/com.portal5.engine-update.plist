<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.portal5.engine-update</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd __PORTAL_ROOT__ &amp;&amp; set -a &amp;&amp; . ./.env 2&gt;/dev/null; set +a; exec .venv/bin/python scripts/engine_autoupdate.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- Daily 04:37 local. Every run re-proves the engine contract (values Portal
         sends reach the model) when an engine version changed; weekly — or at
         once when an engine is security-flagged — it updates Ollama/oMLX, gates
         the update on the contract, and rolls back on failure. Defers while a
         WFE/UAT/bench run is in flight. See scripts/engine_autoupdate.py. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>37</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/engine-update.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/engine-update.launchd.log</string>
</dict>
</plist>
