            "escape_hatch": {
              "type": "object",
              "description": "Tier B: bounded CSG subtree for geometry the Tier-A vocabulary can't express. Steer to Tier A first; only drop here when necessary. Parameter references and expressions are still resolved by the emitter.",
              "additionalProperties": false,
              "properties": {
                "csg": {
                  "$ref": "#/definitions/csgNode"
                }
              }
