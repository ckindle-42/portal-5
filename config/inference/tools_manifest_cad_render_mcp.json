                },
                "dimensions": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                },
                "vector": {
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "amount": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "children": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/csgNode"
                  }
                },
                "child": {
                  "$ref": "#/definitions/csgNode"
                }
              },
              "required": [
                "op"
              ]
            }
          }
        }
      },
      "required": [
        "geometry"
      ],
      "type": "object"
    }
