[
  {
    "description": "Render a 3D mesh file (STL/3MF/OBJ/PLY) to a PNG image. Headless, no GUI. Returns the PNG path/URL and the mesh bounding-box dimensions in model units.",
    "name": "render_mesh",
    "parameters": {
      "properties": {
        "mesh_path": {
          "description": "Absolute path or filename of the mesh (e.g. part.stl) produced by the CAD sandbox",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "description": "Short description of the part, used only by the review loop",
          "type": "string"
        },
        "resolution": {
          "default": 1024,
          "description": "Square render resolution in px",
          "type": "integer"
        },
        "review": {
          "default": false,
          "description": "If true AND CAD_RENDER_REVIEW_LOOP=1, send the PNG to the vision model for a geometry critique",
          "type": "boolean"
        }
      },
      "required": [
        "mesh_path"
      ],
      "type": "object"
    }
  },
  {
    "description": "Render OpenSCAD source code to a PNG using the openscad binary in headless --render mode.",
    "name": "render_openscad",
    "parameters": {
      "properties": {
        "code": {
          "description": "OpenSCAD source code",
          "type": "string"
        },
        "resolution": {
          "default": 1024,
          "description": "Square render resolution in px",
          "type": "integer"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    }
  },
  {
    "description": "Convert between CAD/mesh formats (STL/3MF/OBJ/PLY; STEP read is best-effort if build123d/OCP is present). Returns the output path/URL.",
    "name": "convert_cad",
    "parameters": {
      "properties": {
        "input_path": {
          "description": "Absolute path or filename of the input model",
          "type": "string"
        },
        "to_format": {
          "description": "Target extension without dot: stl | 3mf | obj | ply",
          "type": "string"
        }
      },
      "required": [
        "input_path",
        "to_format"
      ],
      "type": "object"
    }
  },
  {
    "description": "PRIMARY tool for parts with holes/pockets/patterns/shells/standoffs. Generate a parametric part from a constrained feature-level JSON geometry description (base solid + named features positioned by face+anchor+offset, never raw 3D coordinates). Validates, emits OpenSCAD, compiles, mesh-validates, renders, and self-corrects (auto-retries deterministic fixes) in one call. Returns scad_source, stl_path, png_url, validation (watertight/volume/bbox/problems), attempts, retry_log.",
    "name": "generate_scad",
    "parameters": {
      "properties": {
        "geometry": {
          "description": "Feature-level part description for generate_scad. Z-up, right-handed, millimetres: width=X, depth=Y, height=Z; a flat plate's thickness is height, never depth. Tier A (base + named features positioned by face+anchor+offset) is preferred — the model describes WHAT and deterministic code computes WHERE.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base"
          ],
          "properties": {
            "units": {
              "type": "string",
              "enum": [
                "mm"
              ],
              "default": "mm",
              "description": "All dimensions are millimetres. Coordinates are right-handed and Z-up."
            },
            "parameters": {
              "type": "object",
              "description": "Named variables: name -> number or arithmetic expression string referencing other parameters (e.g. \"width - 2*wall_thickness\"). Resolved by a restricted evaluator, never eval().",
              "additionalProperties": {
                "type": [
                  "number",
                  "string"
                ]
              }
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "part_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "print_orientation_hint": {
                  "type": "string"
                }
              }
            },
            "base": {
              "type": "object",
              "description": "Tier A primary solid. Z-up/right-handed: box width=X, depth=Y, height=Z. For a flat plate, thickness is height.",
              "required": [
                "type",
                "dimensions"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "box",
                    "cylinder"
                  ]
                },
                "dimensions": {
                  "type": "object",
                  "description": "box: width=X, depth=Y, height=Z; cylinder: radius in XY, axis at (radius,radius), and height=Z. Millimetres. For a flat plate thickness is height.",
                  "properties": {
                    "width": {
                      "type": [
                        "number",
                        "string"
                      ],
                      "description": "X-axis extent in millimetres."
                    },
                    "depth": {
                      "type": [
                        "number",
                        "string"
                      ],
                      "description": "Y-axis extent in millimetres; not plate thickness."
                    },
                    "height": {
                      "type": [
                        "number",
                        "string"
                      ],
                      "description": "Z-axis extent in millimetres; this is plate thickness."
                    },
                    "radius": {
                      "type": [
                        "number",
                        "string"
                      ],
                      "description": "Cylinder radius in the XY plane, in millimetres."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "box"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "dimensions": {
                        "required": [
                          "width",
                          "depth",
                          "height"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "cylinder"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "dimensions": {
                        "required": [
                          "radius",
                          "height"
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "shell": {
              "type": "object",
              "description": "Hollow the base solid.",
              "required": [
                "wall_thickness"
              ],
              "additionalProperties": false,
              "properties": {
                "wall_thickness": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "open_face": {
                  "type": "string",
                  "enum": [
                    "top",
                    "bottom",
                    "front",
                    "back",
                    "left",
                    "right",
                    "none"
                  ],
                  "default": "top"
                }
              }
            },
            "holes": {
              "type": "array",
              "description": "Cylindrical through/blind holes positioned by face + semantic anchor + offset, never by raw 3D coordinates.",
              "items": {
                "type": "object",
                "required": [
                  "diameter",
                  "face",
                  "offset_from",
                  "offset_x",
                  "offset_y"
                ],
                "additionalProperties": false,
                "properties": {
                  "diameter": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "depth": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "description": "Omit or set >= base thickness for a through-hole."
                  },
                  "face": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom",
                      "front",
                      "back",
                      "left",
                      "right"
                    ]
                  },
                  "offset_from": {
                    "type": "string",
                    "enum": [
                      "corner",
                      "center",
                      "edge"
                    ]
                  },
                  "offset_x": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "offset_y": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "chamfer": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "description": "Symmetric edge chamfer size in mm at the hole entrance."
                  },
                  "counterbore": {
                    "type": "object",
                    "required": [
                      "diameter",
                      "depth"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "diameter": {
                        "type": [
                          "number",
                          "string"
                        ]
                      },
                      "depth": {
                        "type": [
                          "number",
                          "string"
                        ]
                      }
                    }
                  },
                  "countersink": {
                    "type": "object",
                    "required": [
                      "diameter",
                      "angle"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "diameter": {
                        "type": [
                          "number",
                          "string"
                        ]
                      },
                      "angle": {
                        "type": [
                          "number",
                          "string"
                        ],
                        "description": "Included countersink angle in degrees."
                      }
                    }
                  }
                }
              }
            },
            "pockets": {
              "type": "array",
              "description": "Rectangular recesses positioned by face + anchor + offset.",
              "items": {
                "type": "object",
                "required": [
                  "width",
                  "depth_dim",
                  "cut_depth",
                  "face",
                  "offset_from",
                  "offset_x",
                  "offset_y"
                ],
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "depth_dim": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "description": "Pocket footprint depth (in-plane), not cut depth."
                  },
                  "cut_depth": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "description": "How far the pocket is cut into the base."
                  },
                  "face": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom",
                      "front",
                      "back",
                      "left",
                      "right"
                    ]
                  },
                  "offset_from": {
                    "type": "string",
                    "enum": [
                      "corner",
                      "center",
                      "edge"
                    ]
                  },
                  "offset_x": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "offset_y": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                }
              }
            },
            "standoffs": {
              "type": "array",
              "description": "Cylindrical bosses (e.g. for M3 self-tapping screws), positioned by face + anchor + offset.",
              "items": {
                "type": "object",
                "required": [
                  "outer_diameter",
                  "height",
                  "face",
                  "offset_from",
                  "offset_x",
                  "offset_y"
                ],
                "additionalProperties": false,
                "properties": {
                  "outer_diameter": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "inner_diameter": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "description": "Pilot hole diameter, omit for solid boss."
                  },
                  "height": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "face": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom",
                      "front",
                      "back",
                      "left",
                      "right"
                    ]
                  },
                  "offset_from": {
                    "type": "string",
                    "enum": [
                      "corner",
                      "center",
                      "edge"
                    ]
                  },
                  "offset_x": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "offset_y": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                }
              }
            },
            "fillets": {
              "type": "array",
              "description": "Edge rounding on the base solid's vertical edges (2D-profile round via minkowski, per emitter implementation).",
              "items": {
                "type": "object",
                "required": [
                  "radius"
                ],
                "additionalProperties": false,
                "properties": {
                  "radius": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "edges": {
                    "type": "string",
                    "enum": [
                      "all",
                      "top",
                      "bottom"
                    ],
                    "default": "all"
                  }
                }
              }
            },
            "chamfers": {
              "type": "array",
              "description": "Edge chamfers on the base solid.",
              "items": {
                "type": "object",
                "required": [
                  "size"
                ],
                "additionalProperties": false,
                "properties": {
                  "size": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "edges": {
                    "type": "string",
                    "enum": [
                      "all",
                      "top",
                      "bottom"
                    ],
                    "default": "all"
                  }
                }
              }
            },
            "ribs": {
              "type": "array",
              "description": "Thin reinforcement webs between two faces.",
              "items": {
                "type": "object",
                "required": [
                  "thickness",
                  "height",
                  "face",
                  "offset_from",
                  "offset_x",
                  "offset_y"
                ],
                "additionalProperties": false,
                "properties": {
                  "thickness": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "height": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "face": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom",
                      "front",
                      "back",
                      "left",
                      "right"
                    ]
                  },
                  "offset_from": {
                    "type": "string",
                    "enum": [
                      "corner",
                      "center",
                      "edge"
                    ]
                  },
                  "offset_x": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "offset_y": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                }
              }
            },
            "pattern": {
              "type": "object",
              "description": "Repeat a named feature (by index into its list) linearly or circularly.",
              "required": [
                "type",
                "feature_kind",
                "feature_index",
                "count"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "circular"
                  ]
                },
                "feature_kind": {
                  "type": "string",
                  "enum": [
                    "holes",
                    "standoffs",
                    "pockets",
                    "ribs"
                  ]
                },
                "feature_index": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Index of the template feature within its list to repeat."
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "spacing": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "linear pattern: center-to-center spacing."
                },
                "angle": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "circular pattern: total sweep angle in degrees (default 360)."
                }
              }
            },
            "escape_hatch": {
              "type": "object",
              "description": "Tier B: bounded CSG subtree for geometry the Tier-A vocabulary can't express. Steer to Tier A first; only drop here when necessary. Parameter references and expressions are still resolved by the emitter.",
              "additionalProperties": false,
              "properties": {
                "csg": {
                  "$ref": "#/definitions/csgNode"
                }
              }
            }
          },
          "definitions": {
            "csgNode": {
              "type": "object",
              "description": "One node in a constrained CSG tree: a primitive, a transform wrapping one child, or a boolean/extrude op over children.",
              "additionalProperties": false,
              "properties": {
                "op": {
                  "type": "string",
                  "enum": [
                    "box",
                    "cylinder",
                    "sphere",
                    "translate",
                    "rotate",
                    "scale",
                    "union",
                    "difference",
                    "intersection",
                    "linear_extrude",
                    "rotate_extrude"
                  ]
                },
                "dimensions": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                },
                "vector": {
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "amount": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "children": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/csgNode"
                  }
                },
                "child": {
                  "$ref": "#/definitions/csgNode"
                }
              },
              "required": [
                "op"
              ]
            }
          }
        },
        "resolution": {
          "default": 1024,
          "description": "Square render resolution in px",
          "type": "integer"
        },
        "max_retries": {
          "default": 2,
          "description": "Max auto-repair attempts inside the tool before returning to the model",
          "type": "integer"
        }
      },
      "required": [
        "geometry"
      ],
      "type": "object"
    }
