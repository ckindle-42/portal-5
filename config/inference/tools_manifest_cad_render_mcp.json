                      "string"
                    ]
                  },
                  "inner_diameter": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "description": "Pilot hole diameter, omit for solid boss."
                  },
                  "height": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "face": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom",
                      "front",
                      "back",
                      "left",
                      "right"
                    ]
                  },
                  "offset_from": {
