          "definitions": {
            "csgNode": {
              "type": "object",
              "description": "One node in a constrained CSG tree: a primitive, a transform wrapping one child, or a boolean/extrude op over children.",
              "additionalProperties": false,
              "properties": {
                "op": {
                  "type": "string",
                  "enum": [
                    "box",
                    "cylinder",
                    "sphere",
                    "translate",
                    "rotate",
                    "scale",
                    "union",
                    "difference",
                    "intersection",
                    "linear_extrude",
                    "rotate_extrude"
