# Portal 5 — Cloudflare Tunnel ingress reference
#
# This is a REFERENCE file, not consumed by the Portal 5 stack. Your real
# cloudflared config (typically ~/.cloudflared/config.yml or wherever
# `cloudflared service install` placed it) needs the rule below merged into
# its `ingress:` list.
#
# Portal 5 has ONE external surface: Open WebUI on :8080. Every generated file
# (speech, music, 3D, documents, spreadsheets, images, transcripts) is handed
# back through Open WebUI's own files API, so a single catch-all rule to :8080
# is all the tunnel needs — no per-service ports, no path rules. Set
# PORTAL_PUBLIC_URL and OWUI_API_KEY in .env (see the "Generated-file links"
# section there).
#
# Replace `tunnel:`, `credentials-file:`, and the hostname with your values
# (`cloudflared tunnel list`, `cloudflared tunnel route dns <tunnel> <hostname>`).
# After editing: `cloudflared tunnel run` (or restart the service). No Portal 5
# service needs to restart for ingress changes — only cloudflared.

tunnel: 00000000-0000-0000-0000-000000000000
credentials-file: /Users/<you>/.cloudflared/00000000-0000-0000-0000-000000000000.json

ingress:
  - hostname: portal.example.com
    service: http://localhost:8080

  # Required final rule per cloudflared spec
  - service: http_status:404
