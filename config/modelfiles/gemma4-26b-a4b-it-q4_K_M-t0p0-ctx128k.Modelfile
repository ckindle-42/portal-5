# gemma4:26b-a4b-it-q4_K_M-t0p0-ctx128k — compliance-reading seat tag.
# Bakes temperature 0.0 (deterministic decode, within the compliance lane
# ceiling) over the shared ctx128k parent so settings_audit sampling_baked_hot
# stays clear when a request omits the workspace override. Same weights and
# num_ctx as the parent — 0 extra bytes.
# Create with:
#   ollama create gemma4:26b-a4b-it-q4_K_M-t0p0-ctx128k \
#     -f config/modelfiles/gemma4-26b-a4b-it-q4_K_M-t0p0-ctx128k.Modelfile
FROM gemma4:26b-a4b-it-q4_K_M-ctx128k
PARAMETER temperature 0.0