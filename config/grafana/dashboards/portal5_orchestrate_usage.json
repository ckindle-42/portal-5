    },
    {
      "id": 14,
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "title": "Plans with no vendor quota API",
      "description": "These plans are real and consumed but expose nothing to read, so their headroom falls back to counting local runs \u2014 a proxy that understated real consumption by ~40x when measured, because one dispatch is many billed requests. For these the reliable signal of exhaustion is a dispatch failing. Shown so they are never mistaken for idle.",
      "targets": [
        {
          "refId": "A",
          "expr": "orchestrate_plan_has_vendor_quota == 0",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
