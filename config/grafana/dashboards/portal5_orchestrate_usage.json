          "refId": "A",
          "expr": "sum by (plan) (orchestrate_cost_usd_total{plan=~\"deepseek|mimo|kimi\"})",
          "legendFormat": "{{plan}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
