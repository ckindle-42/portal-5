{
  "uid": "portal5-orchestrate-usage",
  "title": "Portal 5 \u2014 Orchestrated Worker Usage & Cost",
  "tags": [
    "portal5",
    "orchestrate",
    "cost"
  ],
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "1h",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "description": "Plan quota, token usage and cost for the Claude Code orchestration layer. Quota comes from the vendors themselves (Z.ai Coding Plan pools, DeepSeek and Moonshot balances) and is polled hourly; spend comes from the dispatcher's registry. MiMo publishes no balance endpoint and Codex/Grok are flat-rate subscriptions with no quota API, so they appear in spend but not in quota.",
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Plan headroom \u2014 switch before a plan blocks",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "bargauge",
      "title": "Plan headroom \u2014 every plan that publishes a quota",
      "description": "Share of each rolling window still available. Covers Z.ai's two Coding Plan pools and Claude Pro's 5-hour and 7-day windows (the orchestrator's own budget \u2014 Opus drains it faster than Sonnet). Green above 40%, amber from 15%, red below; `auto` stops choosing a worker plan under 15%.",
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * orchestrate_quota_remaining / orchestrate_quota_limit",
          "legendFormat": "{{plan}} \u00b7 {{window}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 15
              },
              {
                "color": "#199e70",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "minVizHeight": 24,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
