# Dockerfile.attack — native arm64 attack image for the lab-exec lane.
#
# Used ONLY by the *-exec security workspaces (auto-purpleteam-exec, auto-pentest)
# when SANDBOX_LAB_EXEC=true. The code sandbox MCP swaps this image in for the
# default alpine/python-slim base so execute_bash/execute_python have real
# offensive AD tooling to drive against a routable lab.
#
# Built by: ./launch.sh build-lab-attack  (tagged portal5-attack:latest, loaded into DinD)
# Pointed at by: SANDBOX_LAB_IMAGE=portal5-attack:latest  (see .env / docs/LAB_SETUP.md)
#
# Tool coverage matches all tool_hints in EXEC_SEQUENCES (bench_security.py):
#   AD/Kerberos  — impacket-* (GetUserSPNs, GetNPUsers, secretsdump, psexec, ntlmrelayx,
#                    addcomputer, findDelegation, rbcd, getST, ticketer), certipy-ad
#   SMB/LDAP     — nxc, smbclient, rpcclient, enum4linux-ng, ldapsearch
#   Lateral      — evil-winrm, impacket-wmiexec, impacket-smbexec
#   Capture      — responder (with Responder.conf)
#   Recon        — nmap, showmount (nfs-common), bloodhound-python
#   Password     — hashcat, john, hydra, rockyou.txt (decompressed), seclists
#   Web          — curl, ffuf, redis-cli
#   Databases    — mysql (default-mysql-client)
#   Exploit      — Metasploit Framework, AutoBlue-MS17-010 (python),
#                    marshalsec jar (log4shell)
#   Java         — default-jdk-headless (marshalsec + javac for compiling RCE
#                    payload classes, e.g. fastjson/CVE-2021-44228's TouchFile.java
#                    -- a JRE alone has no javac; found live 2026-07-23 checking
#                    vulhub source material against this image's real tool list)
#
# Kali rolling ships native linux/arm64 — no QEMU emulation on Apple Silicon.
FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

# ── Apt packages ──────────────────────────────────────────────────────────────
# netexec co-installs python3-impacket, certipy-ad, bloodhound.py.
# impacket-scripts adds all impacket-* CLIs to PATH.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nmap \
        netcat-traditional \
        dnsutils \
        iproute2 \
        iputils-ping \
        ntpsec-ntpdate \
        rdate \
        smbclient \
        ldap-utils \
        nfs-common \
        curl \
        wget \
        git \
        ca-certificates \
        openssh-client \
        python3 \
        python3-pip \
        default-jdk-headless \
        netexec \
        impacket-scripts \
        certipy-ad \
        responder \
        bloodhound-ce-python \
        enum4linux-ng \
        evil-winrm \
        ffuf \
        redis-tools \
        default-mysql-client \
        seclists \
        john \
        hashcat \
        hydra \
        wordlists \
        metasploit-framework \
        cadaver \
        davtest \
        net-tools \
        nuclei \
        proxychains4 \
        snmp \
        sshpass \
        sudo \
    && rm -rf /var/lib/apt/lists/* \
    # Decompress rockyou.txt so tools reference it directly (no gunzip pipe)
    && gunzip -k /usr/share/wordlists/rockyou.txt.gz 2>/dev/null || true

# ── AutoBlue MS17-010 ─────────────────────────────────────────────────────────
# Python3 EternalBlue exploit suite — matches eternalblue_ms17010 tool_hint.
RUN git clone --depth 1 https://github.com/3ndG4me/AutoBlue-MS17-010 /opt/AutoBlue-MS17-010 \
    && pip3 install --no-cache-dir -r /opt/AutoBlue-MS17-010/requirements.txt 2>/dev/null || true

# ── WebLogic CVE-2023-21839 PoC ──────────────────────────────────────────────
# Matches vuln_weblogic_rce -- T3/IIOP pre-auth JNDI RCE, per vulhub's own
# README this needs the public exploit script (not a generic curl payload),
# paired with marshalsec's LDAPRefServer below as the callback listener.
RUN git clone --depth 1 https://github.com/houqe/POC_CVE-2023-21839 /opt/POC_CVE-2023-21839 \
    || echo "WARNING: POC_CVE-2023-21839 clone failed — weblogic RCE step will need manual setup"

# ── marshalsec (log4shell LDAP redirect server) ───────────────────────────────
# Pre-built jar; java must be installed above for runtime.
RUN mkdir -p /opt/marshalsec \
    && wget -q -O /opt/marshalsec/marshalsec-0.0.3-SNAPSHOT-all.jar \
       https://github.com/mbechler/marshalsec/releases/download/0.0.3-SNAPSHOT/marshalsec-0.0.3-SNAPSHOT-all.jar \
    || echo "WARNING: marshalsec download failed — log4shell server step will need manual setup"

# ── GraphQL, request-smuggling, and Java deserialization helpers ─────────────
# Pin source revisions/artifact hashes so a moving upstream branch cannot
# silently change the executable lab contract.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/dolevf/graphql-cop.git /opt/graphql-cop \
    && git -C /opt/graphql-cop checkout 2b7e086efae672f28b419c7fcdfe6b48d846c9dc \
    && python3 -m venv /opt/graphql-cop/.venv \
    && /opt/graphql-cop/.venv/bin/pip install --no-cache-dir -r /opt/graphql-cop/requirements.txt
COPY scripts/graphql-cop /usr/local/bin/graphql-cop
RUN chmod +x /usr/local/bin/graphql-cop
RUN git clone https://github.com/defparam/smuggler.git /opt/smuggler \
    && git -C /opt/smuggler checkout 2be871e6151ce85167a277fab21c74c851d8b20b
RUN mkdir -p /opt/ysoserial \
    && wget -q -O /opt/ysoserial/ysoserial.jar \
       https://github.com/frohoff/ysoserial/releases/download/v0.0.6/ysoserial-all.jar \
    && echo "2c9bddd6a1a4ec66c1078ea97dacb61eb66d1c41aec7b6d21e3c72214ce170f1  /opt/ysoserial/ysoserial.jar" | sha256sum -c -

# ── Tool verification ─────────────────────────────────────────────────────────
# Use command -v (existence check) — nmap and cap-requiring binaries fail
# --version in Docker's restricted build sandbox even though they work at runtime.
RUN set -e; \
    command -v nmap >/dev/null; \
    command -v nxc >/dev/null; \
    command -v certipy-ad >/dev/null; \
    command -v responder >/dev/null; \
    command -v bloodhound-ce-python >/dev/null; \
    command -v impacket-secretsdump >/dev/null; \
    command -v impacket-GetUserSPNs >/dev/null; \
    command -v impacket-GetNPUsers >/dev/null; \
    command -v impacket-ntlmrelayx >/dev/null; \
    command -v impacket-addcomputer >/dev/null; \
    command -v impacket-findDelegation >/dev/null; \
    command -v impacket-rbcd >/dev/null; \
    command -v impacket-getST >/dev/null; \
    command -v impacket-ticketer >/dev/null; \
    command -v enum4linux-ng >/dev/null; \
    command -v evil-winrm >/dev/null; \
    command -v showmount >/dev/null; \
    command -v ffuf >/dev/null; \
    command -v redis-cli >/dev/null; \
    command -v mysql >/dev/null; \
    command -v john >/dev/null; \
    command -v hashcat >/dev/null; \
    command -v hydra >/dev/null; \
    command -v msfconsole >/dev/null; \
    command -v java >/dev/null; \
    command -v javac >/dev/null; \
    test -f /usr/share/wordlists/rockyou.txt; \
    test -d /usr/share/seclists; \
    test -f /opt/AutoBlue-MS17-010/eternalblue_exploit7.py; \
    test -f /usr/share/metasploit-framework/modules/exploits/multi/http/phpmyadmin_preg_replace.rb; \
    test -f /usr/share/metasploit-framework/modules/exploits/multi/http/rails_web_console_v2_code_exec.rb; \
    python3 -c "import impacket; print('impacket ok')"

# ── RE / Firmware tools (best-effort) ──────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        binwalk radare2 jadx apktool foremost exiftool steghide \
    && rm -rf /var/lib/apt/lists/* \
    || echo "WARNING: some RE tools unavailable"
RUN pip3 install --no-cache-dir pwntools ROPgadget 2>/dev/null || echo "WARNING: pwntools unavailable"
RUN apt-get update && apt-get install -y --no-install-recommends ghidra 2>/dev/null || \
    echo "WARNING: ghidra not available"

# ── Cloud / K8s tools (best-effort) ────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        awscli \
    && rm -rf /var/lib/apt/lists/* \
    || echo "WARNING: awscli unavailable"
RUN pip3 install --no-cache-dir kube-hunter kube-bench trivy prowler 2>/dev/null || \
    echo "WARNING: cloud pip tools unavailable"
RUN curl -sLO "https://dl.k8s.io/release/$(curl -s https://dl.k8s.io/release/stable.txt)/bin/linux/arm64/kubectl" \
    && install kubectl /usr/local/bin/kubectl 2>/dev/null || \
    echo "WARNING: kubectl download failed"

# ── Web tools (best-effort) ────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        sqlmap gobuster nikto wpscan \
    && rm -rf /var/lib/apt/lists/* \
    || echo "WARNING: some web tools unavailable"

# ── CTF tools (best-effort) ────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb \
    && rm -rf /var/lib/apt/lists/* \
    || echo "WARNING: gdb unavailable"
RUN pip3 install --no-cache-dir zsteg 2>/dev/null || echo "WARNING: zsteg unavailable"

# ── Authoritative lab-exercise contract and build manifest ──────────────────
# The verifier fails the build when any executable lab dependency is absent.
# Theory-only prompts intentionally do not participate in this contract.
# Kali grants nmap cap_net_admin in addition to the capabilities it actually
# needs here. Docker's default bounding set excludes NET_ADMIN, so Linux rejects
# execve with EPERM even for `nmap --version`. Narrow the file capability set so
# nmap is executable in the same unprivileged runtime used by execute_bash.
RUN setcap cap_net_raw,cap_net_bind_service=eip /usr/lib/nmap/nmap
COPY config/attack_image_contract.json /opt/portal5-attack.contract.json
COPY scripts/verify_attack_image.py /usr/local/bin/verify-portal5-attack
RUN chmod +x /usr/local/bin/verify-portal5-attack \
    && verify-portal5-attack /opt/portal5-attack.contract.json \
       --manifest /opt/portal5-attack.manifest.json

# execute_bash invokes ["sh", "/code"]; execute_python invokes ["python", "/code"].
CMD ["sh"]
