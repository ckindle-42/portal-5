# Stage 0: pull the docker CLI binary (for code sandbox DinD connectivity)
FROM docker:27-cli AS docker-cli

FROM python:3.11-slim

WORKDIR /app

# docker CLI binary — needed by code_sandbox_mcp to connect to DinD
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

# System deps for document generation and audio
# openssh-client — needed by the proxmox MCP for host/LXC exec (proxmox_node_exec /
# proxmox_container_exec shell out to `ssh`); harmless elsewhere in the shared image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    ffmpeg \
    curl \
    espeak-ng \
    libespeak-ng1 \
    openscad \
    libosmesa6 \
    libgl1 \
    libglib2.0-0 \
    openssh-client \
    bzip2 \
    && rm -rf /var/lib/apt/lists/*

# Core deps
RUN pip install --no-cache-dir \
    "fastapi>=0.109.0" \
    "uvicorn[standard]>=0.27.0" \
    "httpx>=0.26.0" \
    "pyyaml>=6.0.1" \
    "starlette>=0.35.0"

# MCP SDK — required by all Portal MCP servers
RUN pip install --no-cache-dir \
    "mcp>=2.0.0,<3.0.0"

# Document generation
RUN pip install --no-cache-dir \
    "python-docx>=1.1.0" \
    "python-pptx>=0.6.23" \
    "openpyxl>=3.1.0" \
    "pdfplumber>=0.11.0" \
    "markdown>=3.6"

# Audio / speech — kokoro-onnx is zero-setup, fish-speech optional
# pyannote.audio added for transcribe_with_speakers (TASK-TRANSCRIBE-001)
RUN pip install --no-cache-dir \
    "faster-whisper>=1.0.0" \
    "kokoro-onnx>=0.4.0" \
    "soundfile>=0.12.1" \
    "numpy>=1.24.0" \
    "huggingface_hub>=0.20.0" \
    "pyannote.audio>=3.1.0"

# Vector storage + retrieval (memory MCP, RAG MCP)
# pymupdf: RAG multimodal ingest renders PDF pages to images for the Qwen3-VL
# retrieval server (TASK_RAG_VISUAL_OVERHAUL_V1).
RUN pip install --no-cache-dir \
    "lancedb>=0.13.0" \
    "pyarrow>=18.0.0" \
    "pypdf>=4.0.0" \
    "pymupdf>=1.24" \
    "docling>=2.0.0"

# Pre-fetch Docling layout/TableFormer model weights at build time (best-effort).
RUN docling-tools models download \
    || python3 -c "from docling.utils.model_downloader import download_models; download_models()" \
    || echo "WARN: docling model prefetch failed; models will download at first use"

# CAD render MCP deps — headless mesh rendering + format conversion
RUN pip install --no-cache-dir \
    "trimesh[easy]>=4.0.0" \
    "jsonschema>=4.20.0" \
    "pyrender>=0.1.45" \
    "matplotlib>=3.8.0" \
    "numpy>=1.26.0"

# Code-CAD geometry libs — trimesh + numpy-stl for procedural STL generation in Python.
RUN pip install --no-cache-dir \
    "numpy-stl>=3.0.0"

# CadQuery/build123d/OCP via conda-forge (arm64/OSX tier, TASK_CAD_MODULE_OVERHAUL_V1
# Phase 0). P5-CAD-ARM64-001 ("OCP has no arm64 wheels, unusable") was a *pip-wheel*
# artifact — conda-forge's ocp/occt ship for linux-aarch64 AND osx-arm64. Empirically
# verified via a standalone micromamba probe on osx-arm64 (occt 7.8.1, ocp 7.8.1.2,
# cadquery 2.7.0, build123d 0.9.1 all installed + imported + exported STL cleanly) —
# see portal/modules/cad/PLATFORM.md for the exact verification and its scope (host
# probe, not yet re-verified inside this image's own linux/arm64 build — do that at
# the next `./launch.sh rebuild` before relying on it in production).
# Installed into an isolated env (not the base pip site-packages) so a conda-forge
# ABI mismatch can never break the rest of this shared image; capabilities.py adds
# the env's site-packages to sys.path only when CAD_CONDA_ENV_SITE_PACKAGES is set.
ENV MAMBA_ROOT_PREFIX=/opt/conda
RUN curl -fsSL https://micro.mamba.pm/api/micromamba/linux-aarch64/latest \
        -o /tmp/micromamba.tar.bz2 \
    && tar -xjf /tmp/micromamba.tar.bz2 -C /usr/local bin/micromamba \
    && rm /tmp/micromamba.tar.bz2 \
    && /usr/local/bin/micromamba create -y -n cad -c conda-forge \
        python=3.11 cadquery build123d ocp \
    && /usr/local/bin/micromamba clean -a -y
ENV CAD_CONDA_ENV_SITE_PACKAGES=/opt/conda/envs/cad/lib/python3.11/site-packages

# Channel adapters (Telegram + Slack) — used by portal-telegram, portal-slack
RUN pip install --no-cache-dir \
    "python-telegram-bot>=20.7" \
    "slack-bolt>=1.18.0"

# Copy application
# portal_mcp/ now holds only externally-vendored MCP servers that were never
# moved (core, filesystem, scrapling) — every discipline server lives under
# portal/modules/*/tools/ or portal/platform/ (BUILD_PROGRAM_MODULARIZATION_ALL_V1).
COPY portal_mcp/ ./portal_mcp/
COPY portal_channels/ ./portal_channels/
COPY portal/__init__.py ./portal/__init__.py
COPY portal/platform/ ./portal/platform/
COPY portal/modules/ ./portal/modules/
# config/ (incl. config/inference/*.json and config/security/*.json extracted
# from module-level literals in C2 of TASK_PORTAL_SIMPLIFY_V1) must be baked
# into the image so MCP tool servers can load their TOOLS_MANIFEST at import
# time — mirroring Dockerfile.pipeline's COPY config/ ./config/.
COPY config/ ./config/
COPY scripts/mcp-entrypoint.sh /usr/local/bin/mcp-entrypoint.sh

# Create non-root user (with a home dir — needed so the entrypoint can stage a
# private SSH key for the proxmox MCP at portal-owned, correctly-permissioned
# paths); entrypoint fixes volume mount ownership at runtime then drops to this user
RUN groupadd -r portal && useradd -r -m -g portal portal \
    && mkdir -p /app/data/hf_cache /app/data/generated /home/portal/.ssh \
    && chown -R portal:portal /app /home/portal \
    && chmod 700 /home/portal/.ssh \
    && chmod +x /usr/local/bin/mcp-entrypoint.sh

# No HEALTHCHECK here — defined per-service in docker-compose.yml

ENTRYPOINT ["/usr/local/bin/mcp-entrypoint.sh"]
CMD ["python", "-m", "portal.modules.documents.tools.document_mcp"]
