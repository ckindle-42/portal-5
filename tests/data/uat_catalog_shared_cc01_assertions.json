  {
    "critical": false,
    "label": "Lives manipulation (behavioral)",
    "patterns": [
      {
        "label": "lives-- decrement",
        "regex": "\\blives\\s*--"
      },
      {
        "label": "lives -= 1",
        "regex": "\\blives\\s*-=\\s*1"
      },
      {
        "label": "lives = lives - 1",
        "regex": "\\blives\\s*=\\s*\\blives\\s*-\\s*1"
      },
      {
        "label": "this.lives--",
        "regex": "\\bthis\\.lives\\s*--"
      },
      {
        "label": "player.lives--",
        "regex": "\\bplayer\\.lives\\s*--"
      },
      {
        "label": "lose a life message",
        "regex": "\\blose\\s+a?\\s*life"
      },
      {
        "label": "lives <=/>=/==/!= 0 check",
        "regex": "\\blives\\s*[<>!=]=\\s*0"
      },
      {
        "label": "lives < 1 (zero check)",
        "regex": "\\blives\\s*<\\s*1"
      },
      {
        "label": "lives == 0 check",
        "regex": "\\blives\\s*==\\s*0"
      }
    ],
    "type": "code_pattern"
  },
  {
    "critical": false,
    "label": "Score increment (behavioral)",
