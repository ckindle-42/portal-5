              "code": "// Parametric Spur Gear\n// Units: mm\n\nteeth = 12;\nmodule = 2;\nface_width = 8;\nbore_diameter = 5;\n\npitch_diameter = teeth * module;\nbase_diameter = pitch_diameter * cos(20); // 20 degree pressure angle approximation\naddendum = module;\ndedendum = 1.25 * module;\nouter_diameter = pitch_diameter + 2 * addendum;\nroot_diameter = pitch_diameter - 2 * dedendum;\n\n// Simple approximation of gear teeth using a polygon approach\nmodule gear_shape(r_outer, r_inner, teeth_count, module_val) {\n    angle_step = 360 / teeth_count;\n    \n    union() {\n        for (i = [0 : teeth_count - 1]) {\n            rotate([0, 0, i * angle_step])\n            polygon(points=[\n                [r_inner, -module_val/2],\n                [r_outer, -module_val/4],\n                [r_outer, module_val/4],\n                [r_inner, module_val/2]\n            ]);\n        }\n        // Add a central disk to fill the gaps\n        cylinder(h = face_width, r = r_inner, center = true);\n    }\n}\n\n// For a more robust gear, we use a simplified tooth profile\nmodule spur_gear() {\n    difference() {\n        // Main Gear Body\n        union() {\n            // Create a simplified tooth profile using a cylinder and small tooth segments\n            // This is a simplified model for visualization\n            cylinder(h = face_width, r = (pitch_diameter/2), $fn=teeth*4, center=true);\n            \n            // Add teeth\n            for (i = [0 : teeth - 1]) {\n                rotate([0, 0, i * (360/teeth)])\n                translate([pitch_diameter/2, 0, 0])\n                cube([module * 2, module * 1.5, face_width], center=true);\n            }\n        }\n        \n        // Bore hole\n        cylinder(h = face_width + 2, d = bore_diameter, center=true);\n    }\n}\n\n// Since the above is a very rough approximation, let's use a more standard \n// approach for a \"parametric\" gear representation in OpenSCAD\nmodule gear_refined() {\n    pitch_radius = pitch_diameter / 2;\n    addendum_radius = pitch_radius + module;\n    dedendum_radius = pitch_radius - 1.25 * module;\n    \n    difference() {\n        union() {\n            // Base cylinder\n            cylinder(h = face_width, r = pitch_radius, center = true, $fn = teeth * 2);\n            \n            // Teeth\n            for (i = [0 : teeth - 1]) {\n                rotate([0, 0, i * (360 / teeth)])\n                translate([pitch_radius, 0, 0])\n                linear_extrude(height = face_width, center = true)\n                polygon(points=[\n                    [0, -module/2],\n                    [module, -module/4],\n                    [module, module/4],\n                    [0, module/2]\n                ]);\n            }\n        }\n        // Bore\n        cylinder(h = face_width + 2, d = bore_diameter, center = true, $fn = 32);\n    }\n}\n\n// Final Render Call\ngear_refined();\n"
