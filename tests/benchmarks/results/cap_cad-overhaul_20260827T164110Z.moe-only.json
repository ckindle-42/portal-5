              "code": "// Parametric Sensor Enclosure\nwidth = 60;\ndepth = 40;\nheight = 25;\nwall = 2;\nstandoff_dist = 5;\nstandoff_dia = 5;\nstandoff_h = 15;\nhole_dia = 3;\nlip_depth = 1.5;\n\nmodule enclosure() {\n    difference() {\n        // Main Box\n        cube([width, depth, height]);\n        \n        // Hollow interior\n        translate([wall, wall, wall])\n            cube([width - 2*wall, depth - 2*wall, height]);\n        \n        // Top opening (lid lip area)\n        translate([wall, wall, height - lip_depth])\n            cube([width - 2*wall, depth - 2*wall, lip_depth + 0.1]);\n    }\n    \n    // Lid Lip (inner rim)\n    difference() {\n        translate([wall, wall, height - lip_depth])\n            cube([width - 2*wall, depth - 2*wall, lip_depth]);\n        translate([wall + 1, wall + 1, height - lip_depth - 0.1])\n            cube([width - 2*wall - 2, depth - 2*wall - 2, lip_depth + 0.2]);\n    }\n\n    // Corner Standoffs\n    for (x = [standoff_dist, width - standoff_dist]) {\n        for (y = [standoff_dist, depth - standoff_dist]) {\n            translate([x, y, wall])\n                difference() {\n                    cylinder(d=standoff_dia, h=standoff_h, $fn=32);\n                    translate([0, 0, -0.1])\n                        cylinder(d=hole_dia, h=standoff_h + 0.2, $fn=32);\n                }\n        }\n    }\n}\n\nenclosure();\n"
